# ============================================================
# FreeTools — 环境变量示例
# 复制为 .env.local / .env / .env.production 后按需修改
# ============================================================

# 站点主域名（影响 canonical / hreflang / sitemap / 结构化数据，务必填写线上真实域名）
NUXT_PUBLIC_SITE_URL=https://www.freetools.fun

# 站点品牌名
NUXT_PUBLIC_BRAND=FreeTools

# ---------- 广告（Google AdSense 变现） ----------
# ★ 广告总开关：默认 false —— 全站不输出任何广告 DOM（含开发占位框）。
#   流量达标、AdSense 审核通过后，把下面这一项改为 true 并重新构建，10 个预留版位即全部上线。
NUXT_PUBLIC_ADS_ENABLED=false

# ---- 以下为开启广告后需要填写的 AdSense 配置 ----
# 填入你的 AdSense 发布商 ID，例如 ca-pub-1234567890123456
NUXT_PUBLIC_ADSENSE_CLIENT=
# AdSense 开关：总开关为 true 且这里也为 true 才会真正加载广告脚本
NUXT_PUBLIC_ADSENSE_ENABLED=false
# 通用广告单元 ID（数字，在 AdSense 后台创建广告单元后获取）
# 填了这一项，全站所有广告位都会用同一个单元，最快上线方式
NUXT_PUBLIC_ADSENSE_SLOT=

# 各版位专属广告单元 ID（可选，留空则回落到上面的通用值）
NUXT_PUBLIC_ADSENSE_SLOT_LEADERBOARD=
NUXT_PUBLIC_ADSENSE_SLOT_RECTANGLE=
NUXT_PUBLIC_ADSENSE_SLOT_SKYSCRAPER=
NUXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
NUXT_PUBLIC_ADSENSE_SLOT_HORIZONTAL=
NUXT_PUBLIC_ADSENSE_SLOT_MULTIPLEX=

# ---------- Google Search Console（可选） ----------
NUXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---------- 统计（可选，建议用 Google Analytics 4 / Plausible） ----------
# 可选值：ga4 | plausible | '' (关闭)
NUXT_PUBLIC_ANALYTICS_PROVIDER=
NUXT_PUBLIC_ANALYTICS_ID=
